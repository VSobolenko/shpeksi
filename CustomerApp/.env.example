# CustomerApp environment variables.
# Copy this file to `.env` and fill in real values — `.env` is git-ignored.
# Staging/production builds should set these per EAS build profile instead of
# committing a single `.env`.

GRAPHQL_URL=http://localhost:8000/graphql
WS_GRAPHQL_URL=ws://localhost:8000/graphql
SERVER_URL=http://localhost:8000/
# Which restaurant this build belongs to. The backend is multi-tenant; for
# local development the demo seed uses this slug.
RESTAURANT_SLUG=pikupo-demo
EXPO_CLIENT_ID_GOOGLE=<google-oauth-expo-client-id>
IOS_CLIENT_ID_GOOGLE=<google-oauth-ios-client-id>
ANDROID_CLIENT_ID_GOOGLE=<google-oauth-android-client-id>
AMPLITUDE_API_KEY=<amplitude-api-key>
STRIPE_PUBLIC_KEY=<stripe-publishable-key>
STRIPE_IMAGE_URL=<stripe-checkout-logo-url>
STRIPE_STORE_NAME=Pikupo

# EAS account/build wiring (optional; set per EAS build profile so no
# account-specific id is hardcoded in app.json).
EAS_PROJECT_ID=<eas-project-id>
EXPO_OWNER=<expo-account-owner>
EXPO_UPDATES_URL=<expo-updates-url>
