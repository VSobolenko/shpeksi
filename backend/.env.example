# ===== App =====
ENV=development
DEBUG=true

# ===== MongoDB =====
# Production must include credentials: mongodb://<user>:<password>@<host>:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=forkly

# ===== Redis (optional). Leave empty to use in-memory pub/sub for local dev =====
# Production must set this AND include a password: redis://:<password>@<host>:6379/0
REDIS_URL=

# ===== Auth / JWT =====
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ===== Bootstrap admin account (used by adminLogin) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ===== CORS (comma-separated origins) =====
CORS_ORIGINS=http://localhost:3000,http://localhost:3006,http://localhost:3007

# ===== Logging =====
LOG_LEVEL=INFO

# ===== Firebase Cloud Messaging (optional). Paste the service-account JSON here,
#       or leave empty to disable push notifications =====
FIREBASE_SERVICE_ACCOUNT_JSON=

# ===== Social OAuth (used to verify Google / Facebook / Apple login tokens) =====
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ===== Docker Compose only (used to build the app's MONGODB_URL / REDIS_URL
#       inside the container and to enable store authentication) =====
MONGO_INITDB_ROOT_USERNAME=forkly
MONGO_INITDB_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Public site address for the Caddy TLS proxy. Use "forkly.example.com" in
# production (automatic HTTPS) or ":80" for a plain-HTTP local test.
SITE_ADDRESS=:80
