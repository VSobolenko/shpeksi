# ===== App =====
ENV=development
DEBUG=true

# ===== MongoDB =====
# Production must include credentials: mongodb://<user>:<password>@<host>:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=pikupo

# ===== Redis (optional). Leave empty to use in-memory pub/sub for local dev =====
# Production must set this AND include a password: redis://:<password>@<host>:6379/0
REDIS_URL=

# ===== Auth / JWT =====
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ===== Bootstrap admin account (used by adminLogin) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ===== CORS (comma-separated origins) =====
CORS_ORIGINS=http://localhost:3000,http://localhost:3006,http://localhost:3007

# ===== Logging =====
LOG_LEVEL=INFO

# ===== Firebase Cloud Messaging (optional). Paste the service-account JSON here,
#       or leave empty to disable push notifications =====
FIREBASE_SERVICE_ACCOUNT_JSON=

# ===== Social OAuth (used to verify Google / Facebook / Apple login tokens) =====
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ===== Docker Compose only (used to build the app's MONGODB_URL / REDIS_URL
#       inside the container and to enable store authentication) =====
MONGO_INITDB_ROOT_USERNAME=pikupo
MONGO_INITDB_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
# ===== Caddy (TLS proxy + static hosting) =====
# CADDYFILE picks the site config that Caddy loads:
#   - Caddyfile      (default) development: API only, plain HTTP on :80
#   - Caddyfile.prod           demo/production: API + both frontends over HTTPS
CADDYFILE=Caddyfile

# The three variables below are the site addresses. Caddyfile.prod requests a
# Let's Encrypt certificate for each one, so every address must already resolve
# to this server BEFORE the stack starts - otherwise issuance fails and Caddy
# retries against the rate limit.
#
# In development only SITE_ADDRESS is read, and only by the development
# Caddyfile, where ":80" means "serve plain HTTP on port 80, no TLS":
SITE_ADDRESS=:80
API_ADDRESS=
ADMIN_ADDRESS=

# For CADDYFILE=Caddyfile.prod, SITE_ADDRESS is re-read as the marketing site's
# address, so it must be reset from ":80" to the public apex. SITE_ADDRESS may
# list several addresses separated by commas (apex + www).
#
# While the product name is still undecided you can use sslip.io, a public
# wildcard DNS that maps "<ip-with-dashes>.sslip.io" back to that IP - which
# means a real HTTPS certificate without buying a domain yet:
#
#   SITE_ADDRESS=203-0-113-10.sslip.io, www.203-0-113-10.sslip.io
#   API_ADDRESS=api.203-0-113-10.sslip.io
#   ADMIN_ADDRESS=admin.203-0-113-10.sslip.io
#
# With a real domain these become api.example.com / admin.example.com /
# "example.com, www.example.com".
